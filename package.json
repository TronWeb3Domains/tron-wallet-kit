{
  "name": "tron-wallet-kit",
  "version": "0.0.0",
  "private": true,
  "description": "TRON-native wallet kit with clean adapters and product-grade wallet UX.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:examples": "pnpm --filter @tron-wallet-kit/examples dev",
    "dev:website": "pnpm --filter @tron-wallet-kit/website dev",
    "icons:wallets": "node scripts/gen-wallet-icons.mjs",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "@types/node": "^22.13.14",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^9.39.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.3.6",
    "typescript": "^5.8.2",
    "vite": "^7.3.0",
    "vitepress": "^1.6.4",
    "vitest": "^3.0.8"
  }
}
