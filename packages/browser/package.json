{
  "name": "@tron-wallet-kit/browser",
  "version": "0.1.0-beta.0",
  "description": "Browser/CDN entrypoint for TRON Wallet Kit.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:iife && pnpm run build:iife:min",
    "build:lib": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "build:iife": "node ../../scripts/build-browser-iife.mjs",
    "build:iife:min": "node ../../scripts/build-browser-iife-min.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tron-wallet-kit/adapter-tronlink": "workspace:*",
    "@tron-wallet-kit/adapter-walletconnect": "workspace:*",
    "@tron-wallet-kit/client": "workspace:*",
    "@tron-wallet-kit/core": "workspace:*",
    "@tron-wallet-kit/ui": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "beta"
  }
}
