{
  "name": "@tron-wallet-kit/client",
  "version": "0.0.0",
  "description": "Headless client orchestration for TRON Wallet Kit.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node ../../scripts/gen-wallet-icons.mjs",
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "prepack": "node ../../scripts/gen-wallet-icons.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tron-wallet-kit/adapter-tronlink": "workspace:*",
    "@tron-wallet-kit/adapter-walletconnect": "workspace:*",
    "@tron-wallet-kit/adapter-tronwallet-bridge": "workspace:*",
    "@tron-wallet-kit/core": "workspace:*",
    "@tron-wallet-kit/ui": "workspace:*",
    "@tronweb3/tronwallet-adapter-ledger": "^1.1.0",
    "tronweb": "^6.4.0"
  },
  "peerDependencies": {
    "@tronweb3/tronwallet-adapter-imtoken": "*",
    "@tronweb3/tronwallet-adapter-metamask-tron": "*"
  },
  "peerDependenciesMeta": {
    "@tronweb3/tronwallet-adapter-imtoken": {
      "optional": true
    },
    "@tronweb3/tronwallet-adapter-metamask-tron": {
      "optional": true
    }
  }
}
