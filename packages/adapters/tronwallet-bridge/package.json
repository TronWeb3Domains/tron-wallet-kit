{
  "name": "@tron-wallet-kit/adapter-tronwallet-bridge",
  "version": "0.1.0-beta.0",
  "description": "Bridge runtime @tronweb3/tronwallet-adapter instances into TRON Wallet Kit.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tron-wallet-kit/core": "workspace:*"
  },
  "peerDependencies": {
    "@tronweb3/tronwallet-abstract-adapter": "*",
    "tronweb": "*"
  },
  "peerDependenciesMeta": {
    "@tronweb3/tronwallet-abstract-adapter": {
      "optional": true
    },
    "tronweb": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "beta"
  }
}
